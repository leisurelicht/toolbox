<!-- 工具箱首页 -->
<navigation-bar title="工具箱" back="{{false}}" color="#2D2D3A" background="#FBFBFD"></navigation-bar>

<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-badge">
      <view class="badge-dot"></view>
      <text>轻量工具箱</text>
    </view>
    <view class="hero-title">随手实用</view>
    <view class="hero-sub">精选 {{tools.length}} 个工具，保持简单高效</view>
  </view>

  <!-- 工具列表 -->
  <view class="tool-list">
    <view
      wx:for="{{tools}}"
      wx:key="id"
      class="tool-card {{item.comingSoon ? 'is-pending' : ''}}"
      data-tool="{{item}}"
      bind:tap="onToolTap"
    >
      <!-- 图标 -->
      <view class="card-icon" style="background: {{item.iconBg}};">
        <text class="card-icon-text" style="color: {{item.iconColor}};">{{item.symbol}}</text>
      </view>
      <!-- 内容 -->
      <view class="card-main">
        <view class="card-head">
          <text class="card-name">{{item.name}}</text>
          <view wx:if="{{item.comingSoon}}" class="card-tag">
            <text>即将推出</text>
          </view>
        </view>
        <text class="card-desc">{{item.description}}</text>
      </view>
      <!-- 箭头 -->
      <view class="card-arrow">
        <text>›</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-spacer"></view>
</scroll-view>