<!-- 常用和弦进行库 -->
<view class="page-container">
  <view class="top-bar">
    <navigation-bar title="和弦进行" back="{{true}}" color="#2D2D3A" background="#FBFBFD"></navigation-bar>
    <view class="settings">
      <view class="key-grid">
        <view wx:for="{{keys}}" wx:key="label" class="key-cell" data-index="{{index}}" bind:tap="onKey">
          <text class="key-text {{keyIndex === index ? 'active' : ''}}">{{item.label}}</text>
        </view>
      </view>

      <view class="quality-row">
        <view class="q-chip {{seventh ? '' : 'active'}}" data-seventh="false" bind:tap="onQuality">
          <text class="q-text">三和弦</text>
        </view>
        <view class="q-chip {{seventh ? 'active' : ''}}" data-seventh="true" bind:tap="onQuality">
          <text class="q-text">七和弦</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px;">
    <view class="content">
      <view class="prog-card" wx:for="{{views}}" wx:key="id">
        <view class="prog-head">
          <text class="prog-name">{{item.name}}</text>
          <text class="prog-roman">{{item.roman}}</text>
        </view>
        <view class="chord-row">
          <view class="chord-chip" wx:for="{{item.chords}}" wx:for-item="chord" wx:key="key">
            <text class="chord-text">{{chord.name}}</text>
          </view>
        </view>
        <text class="prog-desc">{{item.desc}}</text>
      </view>

      <view class="note-tip">
        <text>和弦按当前调的大调音阶生成；小调作品可参考其关系大调，或把级数整体对应到小调音阶</text>
      </view>
      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
</view>