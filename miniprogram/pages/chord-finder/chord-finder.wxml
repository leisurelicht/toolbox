<!-- 和弦反查器 -->
<view class="page-container">
  <view class="top-bar">
    <navigation-bar title="和弦反查" back="{{true}}" color="#2D2D3A" background="#FBFBFD"></navigation-bar>
    <view class="settings">
      <!-- 音高选择 -->
      <view class="card">
        <view class="card-head">
          <text class="card-title">点选音高</text>
          <text class="card-count">已选 {{selectedCount}} 个音</text>
        </view>

        <view class="grid">
          <view
            wx:for="{{notes}}"
            wx:key="name"
            class="cell"
            data-index="{{index}}"
            bind:tap="onToggle"
          >
            <text class="cell-text {{item.active ? 'active' : ''}}">{{item.name}}</text>
          </view>
        </view>

        <view class="clear-row" bind:tap="onClear">
          <text class="clear-text">清空重选</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px;">
    <view class="content">
      <!-- 识别结果 -->
      <view wx:if="{{matches.length > 0}}" class="result-wrap">
        <view class="result-title">
          <text class="result-title-text">可能的和弦</text>
        </view>
        <view class="match-card" wx:for="{{matches}}" wx:key="key">
          <view class="match-left">
            <text class="match-name">{{item.label}}</text>
            <text class="match-full">{{item.full}}</text>
          </view>
          <text class="match-notes">{{item.notesText}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{emptyText}}" class="empty">
        <text class="empty-text">{{emptyText}}</text>
      </view>

      <view class="note-tip">
        <text>同一组音可能对应多个和弦（如 C6 与 Am7），结果按音数由少到多排列</text>
      </view>

      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
</view>
